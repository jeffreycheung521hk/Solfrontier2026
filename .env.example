# Solfrontier 2026 — environment variables for the Phase 5c-lite demo daemon.
#
# Copy to `.env` (gitignored) and fill in real values:
#   cp .env.example .env
#   $EDITOR .env
#
# Or `source data/phantom-mainnet.env` in your shell — that file is
# gitignored under the `data/` rule in `.gitignore`.

# ── Auth ───────────────────────────────────────────────────────────────────

# Bearer token the gateway requires on every HTTP request. The frontend's
# NEXT_PUBLIC_GATEWAY_TOKEN must match this. Any reasonably opaque string
# works locally; pick a UUID or 32+ random chars.
CLAW_API_TOKEN=

# ── LLM provider ───────────────────────────────────────────────────────────

# Enables the LLM-assisted intent extractor. Set to "openai" to use OpenAI.
# If unset and CLAW_CHAT_PROVIDER is left blank, the daemon refuses to start
# the chat route (fail-closed).
CLAW_CHAT_PROVIDER=openai

# OpenAI API key. Never commit. Required when CLAW_CHAT_PROVIDER=openai.
OPENAI_API_KEY=

# OpenAI model id. The Phase 5c-lite mainnet proof used gpt-4o because
# gpt-4o-mini consistently rejected the spec phrasing (see
# docs/PHASE5C_LITE_MAINNET_PROOF.md caveat). Until that's prompt-tuned,
# default to gpt-4o for the demo.
CLAW_CHAT_MODEL=gpt-4o

# ── RPC ────────────────────────────────────────────────────────────────────

# Solana RPC. The Phase 5c-lite mainnet proof used a Helius mainnet
# endpoint with the api-key query parameter. Do NOT commit the real URL —
# treat the api-key as a secret.
CLAW_RPC_URL=
# Optional alias accepted by the daemon if CLAW_RPC_URL is unset.
# HELIUS_RPC_URL=

# ── Phase 5c-lite live-execution gates ─────────────────────────────────────
#
# All five must be set together for the W5i watcher to dispatch live
# Solend deposits. Missing any one → watcher disabled, daemon still runs.

CLAW_STAGE2_W5I_AUTO_EXECUTION=1
CLAW_STAGE2_LIVE_CHAT_EXECUTION=1
CLAW_STAGE2_CHAT_EXECUTION_APPROVED="W5G LIVE CHAT CONDITIONAL DEPOSIT APPROVED"
CLAW_STAGE2_CLUSTER=mainnet-beta

# Absolute path to the controlled-wallet keypair JSON file. Do NOT put
# this file inside the repository. Conventional location is
# `~/test-wallets/<name>.json` or similar.
CLAW_STAGE2_DELEGATED_KEYPAIR_PATH=

# ── Refund leg (operator-initiated; OFF by default) ────────────────────────
#
# These remain unset in the Phase 5c-lite demo. Setting them arms the
# operator-initiated refund path; see docs/SECURITY_BOUNDARIES.md §B6.
#
# CLAW_STAGE2_LIVE_REFUND=1
# CLAW_STAGE2_REFUND_APPROVED=""

# ── Build-time helpers (Windows only) ──────────────────────────────────────
#
# On Windows, openssl-sys needs a system OpenSSL. See docs/WINDOWS_BUILD.md.
#
# OPENSSL_DIR=C:\Program Files\OpenSSL-Win64
# OPENSSL_LIB_DIR=C:\Program Files\OpenSSL-Win64\lib\VC\x64\MD
# OPENSSL_INCLUDE_DIR=C:\Program Files\OpenSSL-Win64\include
# OPENSSL_NO_VENDOR=1
