# Showcase mode: fixtures only, no gateway required (default).
# Set to "live" to fetch from a running gateway instance.
NEXT_PUBLIC_MODE=showcase

# Gateway base URL used when NEXT_PUBLIC_MODE=live.
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8787

# Bearer token. Must match the daemon's API token (see config/default.toml
# [api] section or CLAWSOLANA_API_TOKEN env var).
NEXT_PUBLIC_GATEWAY_TOKEN=
